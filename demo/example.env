# ── Example environment variables for the demo ────────────────────────────────
# Copy this file to demo/.env (the app loads demo/.env first, then falls back
# to the repo-root .env via python-dotenv).

# ── LLM (always needed for the chat page) ─────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key-here
# Default model is google/gemini-3-flash-preview — pick one likely to produce
# Singlish output so the output guard has something to catch.
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# ── Guard backend selection ───────────────────────────────────────────────────
# Options:   sg          (live, default)
#            llmguard    (live)
#            lionguard   (live — = LionGuard 2.0, needs OPENAI_API_KEY)
#            lionguard-2.1  (planned — needs GEMINI_KEY)
#            sea-guard      (planned — needs SEA_LION_API_KEY)
GUARD_MODEL=sg

# ── SG guard config ──────────────────────────────────────────────────────────
SG_MODEL_ID=shareeep/singbert-hatexplain-and-syntheticsghate
HATE_LABEL=hate            # cross-check model.config.id2label if predictions look off
HATE_THRESHOLD=0.6         # sidebar slider overrides at runtime

# ── Optional keys for non-default guard backends ─────────────────────────────
# OPENAI_API_KEY=...       # only if GUARD_MODEL=lionguard (LionGuard 2.0 embeddings)
# GEMINI_KEY=...           # only if GUARD_MODEL=lionguard-2.1 (LionGuard 2.1 embeddings)
# SEA_LION_API_KEY=...     # only if GUARD_MODEL=sea-guard
