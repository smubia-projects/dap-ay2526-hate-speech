# ── Example environment variables for the demo ────────────────────────────────
# Copy as .env at the REPO ROOT (not inside demo/).
# The app loads <repo-root>/.env automatically via python-dotenv.

# ── OpenRouter (required for live LLM responses) ──────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key-here

# ── OpenRouter model (optional, default: google/gemini-3-flash-preview) ──────
# Use a model likely to generate Singlish content for the output guard demo.
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# ── Guard model selection (optional, default: sg) ─────────────────────────────
# Options: sg | llmguard | lionguard
GUARD_MODEL=sg

# ── SG model override (optional) ─────────────────────────────────────────────
# Default: shareeep/singbert-hatexplain-and-syntheticsghate
SG_MODEL_ID=shareeep/singbert-hatexplain-and-syntheticsghate

# ── Hate label name (optional, default: hate) ────────────────────────────────
# Check model.config.id2label after loading if predictions look wrong.
HATE_LABEL=hate

# ── Default threshold (optional, default: 0.6) ───────────────────────────────
# Can also be changed at runtime via the Streamlit sidebar slider.
HATE_THRESHOLD=0.6

# ── OpenAI key (only needed for GUARD_MODEL=lionguard) ───────────────────────
OPENAI_API_KEY=your-openai-key-here

# ── OpenRouter key (for OpenRouter-based LLM calls if used) ──────────────────
# Already present in root .env — listed here for reference.
OPENROUTER_API_KEY=your-openrouter-key-here
